# Optional. If set, analysis is generated by the Claude API instead of the
# built-in rule-based engine. Leave unset to run fully offline.
ANTHROPIC_API_KEY=

# Optional. If set (GOOGLE_API_KEY also works), analysis is generated by the
# Gemini API instead, taking priority over ANTHROPIC_API_KEY when both are set.
GEMINI_API_KEY=

# Optional. Overrides the model used for AI-backed analysis: the Claude model
# when the value doesn't contain "gemini" (default: claude-sonnet-5),
# otherwise the Gemini model (default: gemini-2.5-flash).
ANALYSIS_MODEL=claude-sonnet-5

# Optional. Port the Flask dev server listens on (default 5000).
PORT=5000
